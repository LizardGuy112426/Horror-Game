  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 0f72133291e5de047b2f0ee7afe91862, type: 3}
    m_FontSize: 44
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 64
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 0.85
  m_Text: "Dear Diary,\n\nLately, she seems to be talking less and less. She used
    to run up to us after school and tell us everything that happened that day. Now,
    when I ask 'How was your day?', she just smiles and says 'It was fine.'\n\nEver
    since her little brother was born, we really have spent too much of our time
    on him. I kept telling myself she was older now, that she would understand how
    busy we were.\n\nBut when I passed by her room today, I suddenly realized\u2014it's
    been so long since I truly asked her, 'Have you been happy lately?'\n\nSometimes
    I want to go in and talk to her, but I never know how to begin. Maybe in a few
    days. When things calm down, I'll sit down and have a proper talk with her."
