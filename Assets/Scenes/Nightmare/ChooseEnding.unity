  m_Script: {fileID: 11500000, guid: 6f6d1274399b4a60883b2e4d8645fc31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChooseEndingSequence2D
  frontDoorTrigger: {fileID: 452574870}
  sceneCamera: {fileID: 0}
  dadPrefab: {fileID: 2705061705741265876, guid: 0b96ec54a2845d34fa6a5f3583207afb, type: 3}
  momPrefab: {fileID: 2936630904677412706, guid: c5797d1962a05314c8930bcbdb6a9453, type: 3}
  dadSpawnPoint: {fileID: 2147000031}
  momSpawnPoint: {fileID: 2147000041}
  dadDoorStop: {fileID: 2147000051}
  momDoorStop: {fileID: 2147000061}
  runParentSpeed: 3.5
  parentSortingLayer: Player
  dadSortingOrder: 21
  momSortingOrder: 20
  playerAutoWalkSpeed: 3
  playerArriveDistance: 0.05
  runSceneName: NewsIntro
  runFadeDuration: 2
  staySceneName: Cutscene3
  stayFadeDuration: 2
  stayLines:
  - speakerName: Parent
    dialogue: ...My child. Are you sure this is what you want?...
  - speakerName: SiJia
    dialogue: ...
  - speakerName: SiJia
    dialogue: ...I know I was never trying to compete with my brother for anything...
  - speakerName: SiJia
    dialogue: I just...
  - speakerName: SiJia
    dialogue: wanted you to truly see me.
  - speakerName: Dad
    dialogue: ...
  - speakerName: Dad
    dialogue: We tried so many times to talk to you, but we never knew how to begin.
      As your father, I...
  - speakerName: Dad
    dialogue: I'm so sorry. We left you to carry all of that alone.
  - speakerName: Mom
    dialogue: No... We never meant to make you feel this way. I failed to notice
      how much you were hurting.
  - speakerName: Mom
    dialogue: Please don't keep suffering in silence... I'm so sorry...
  - speakerName: SiJia
    dialogue: ...
