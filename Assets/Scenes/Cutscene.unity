  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneController
  pages:
  - cgSprite: {fileID: 0}
    speakerName: 
    dialogue: "\u6211\u662Fxxx\uFF0C\u4ECE\u8BB0\u4E8B\u8D77\u6211\u5C31\u5728\u8FD9\u91CC\u751F\u6D3B\u3002\n\u6211\u6BCF\u6B21\u9662\u957F\u90FD\u548C\u6211\u4EEC\u8BF4\u6545\u4E8B\uFF0C\u8BF4\u6211\u4EEC\u662F\u8FD9\u91CC\u7684\u5C0F\u7CBE\u7075\u3002"
  - cgSprite: {fileID: 0}
    speakerName: 
    dialogue: "\u90A3\u5C0F\u7CBE\u7075\u5462\uFF0C\u4E00\u5B9A\u4F1A\u5728\u672A\u6765\u7684\u67D0\u4E00\u5929\u9047\u5230\u4ED6\u9700\u8981\u5B88\u62A4\u7684\u201C\u5BB6\u201D\u3002\n\u867D\u7136\u4E0D\u6E05\u695A\u5BB6\u662F\u4EC0\u4E48\u6837\u7684\u611F\u89C9\uFF0C\u4F46\u6211\u76F8\u4FE1\u4E00\u5B9A\u4F1A\u662F\u5E78\u798F\u7684\u3002"
  - cgSprite: {fileID: 0}
    speakerName: 
    dialogue: "\u800C\u4ECA\u5929\u7EC8\u4E8E\u8F6E\u5230\u6211\uFF0C\u524D\u5F80\u65B0\u5BB6\u5EAD\u53BB\u5B8C\u6210\u6211\u7684\u4F7F\u547D\u3002\n\u4ECA\u540E\uFF0C\u6211\u4E5F\u4E0D\u518D\u662F\u4E00\u4E2A\u4EBA\u4E86\u3002"
  - cgSprite: {fileID: 0}
    speakerName: 
    dialogue: "\u201C\u6B22\u8FCE\u56DE\u5BB6\u201D\u5988\u5988\u8BF4\u3002\r\n\u771F\u7684\u662F\u8D8A\u6765\u8D8A\u671F\u5F85\u4EE5\u540E\u7684\u751F\u6D3B\u4E86\u554A\u3002"
