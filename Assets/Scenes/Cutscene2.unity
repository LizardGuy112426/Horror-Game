  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1396676633}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d2f14a8f6e1442d9d7d81fbcd8a02b9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneController
  pageCount: 5
  pages:
  - cgSprite: {fileID: 4405763563544581183, guid: 96fe17fa704a85949a6ff6aa59209296, type: 3}
    cgSequence: []
    sequenceHoldDuration: 0.35
    sequenceCrossfadeDuration: 0.45
    skipCrossfadeFromPrevious: 0
    speakerName: 
    dialogue: "Those moments were real. I felt that warmth with all my heart\u2014which
      is why everything that came after cuts so deep."
  - cgSprite: {fileID: -2951442481413526113, guid: 5fdf75e96e9a43a4a9b7844b60a95535, type: 3}
    cgSequence: []
    sequenceHoldDuration: 0.35
    sequenceCrossfadeDuration: 0.45
    skipCrossfadeFromPrevious: 0
    speakerName: 
    dialogue: Mom, why is your tummy getting so big? Are you feeling sick?
  - cgSprite: {fileID: -2951442481413526113, guid: 5fdf75e96e9a43a4a9b7844b60a95535, type: 3}
    cgSequence: []
    sequenceHoldDuration: 0.35
    sequenceCrossfadeDuration: 0.45
    skipCrossfadeFromPrevious: 1
    speakerName: 
    dialogue: "Mom: Oh, you silly goose, I\u2019m not sick! We're getting a little
      playmate ready for you! Just imagine how much fun the house will be once he's
      here. And hey, don't you worry\u2014no matter what, your dad and I will love
      you just as much. "
  - cgSprite: {fileID: -6775534545575389172, guid: 3fc2f7194e4c5de499e139fa3eded808, type: 3}
    cgSequence: []
    sequenceHoldDuration: 0.35
    sequenceCrossfadeDuration: 0.45
    skipCrossfadeFromPrevious: 0
    speakerName: 
    dialogue: "'Oh, really? Wow, I can\u2019t wait!'"
  - cgSprite: {fileID: 0}
    cgSequence:
    - {fileID: 3817004439461758447, guid: f5d06f180ffe7924fabd10e0542879e4, type: 3}
    - {fileID: -6782914627205250798, guid: 1782ea6d128a03e498480a9d93382aaa, type: 3}
    - {fileID: -8985976283102869554, guid: fa8c5f4995403df4996f3c7d500412b5, type: 3}
    sequenceHoldDuration: 2
    sequenceCrossfadeDuration: 0.45
