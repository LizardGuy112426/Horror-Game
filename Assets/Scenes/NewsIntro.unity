  m_Script: {fileID: 11500000, guid: 283064a9db5742fb861b8ce43bd1c1cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NewsIntroController
  fadeGroup: {fileID: 589344077}
  titleText: {fileID: 1372061469}
  bodyText: {fileID: 1128488692}
  titleContent: "\u4E2D\u5B66\u751F\u5973\u751F\u5931\u8E2A\u4E00\u4E2A\u6708\u3000\u8B66\u65B9\u547C\u5401\u516C\u4F17\u63D0\u4F9B\u7EBF\u7D22"
  bodyContent: "\u3010\u672C\u62A5\u8BAF\u3011\u4E00\u540D\u4E2D\u5B66\u751F\u5973\u751F\u4E8E\u4E00\u4E2A\u6708\u524D\u88AB\u5BB6\u4EBA\u53D1\u73B0\u5931\u8E2A\uFF0C\u5BB6\u5C5E\u968F\u540E\u5411\u8B66\u65B9\u62A5\u6848\u3002\u81F3\u4ECA\u5973\u7AE5\u4ECD\u4E0B\u843D\u4E0D\u660E\uFF0C\u8B66\u65B9\u76EE\u524D\u6301\u7EED\u5C55\u5F00\u8C03\u67E5\u53CA\u641C\u5BFB\u884C\u52A8\uFF0C\u5E76\u547C\u5401\u516C\u4F17\u63D0\u4F9B\u76F8\u5173\u7EBF\u7D22\u3002\n\n\u636E\u4E86\u89E3\uFF0C\u5931\u8E2A\u5973\u7AE5\u4E3A\u4E00\u540D\u4E2D\u5B66\u751F\uFF0C\u5973\u6027\uFF0C\u8EAB\u9AD8\u7EA6150\u5398\u7C73\uFF0C\u8EAB\u5F62\u504F\u7626\uFF0C\u8138\u578B\u504F\u5706\uFF0C\u7559\u6709\u4E00\u5934\u77ED\u53D1\uFF0C\u53D1\u578B\u4E3A\u8611\u83C7\u5934\u3002\u5973\u7AE5\u5931\u8E2A\u81F3\u4ECA\u5DF2\u6709\u4E00\u4E2A\u6708\uFF0C\u5BB6\u5C5E\u4E00\u76F4\u7126\u6025\u7B49\u5F85\u5979\u7684\u6D88\u606F\uFF0C\u5E76\u5E0C\u671B\u5979\u80FD\u591F\u5E73\u5B89\u56DE\u5BB6\u3002\n\n\u8B66\u65B9\u547C\u5401\uFF0C\u4EFB\u4F55\u66FE\u89C1\u8FC7\u8BE5\u540D\u5973\u7AE5\uFF0C\u6216\u638C\u63E1\u5176\u884C\u8E2A\u53CA\u76F8\u5173\u4FE1\u606F\u7684\u516C\u4F17\uFF0C\u5E94\u5C3D\u5FEB\u5411\u8B66\u65B9\u63D0\u4F9B\u7EBF\u7D22\uFF0C\u4EE5\u534F\u52A9\u8C03\u67E5\u53CA\u641C\u5BFB\u5DE5\u4F5C\u3002\n\n\u5BB6\u5C5E\u4E5F\u547C\u5401\u793E\u4F1A\u5927\u4F17\u5173\u6CE8\u5BFB\u4EBA\u6D88\u606F\uFF0C\u5982\u53D1\u73B0\u7B26\u5408\u4E0A\u8FF0\u7279\u5F81\u7684\u5931\u8E2A\u5973\u7AE5\uFF0C\u8BF7\u7ACB\u5373\u8054\u7CFB\u8B66\u65B9\u3002\u5BB6\u4EBA\u8868\u793A\uFF0C\u4ED6\u4EEC\u81F3\u4ECA\u4ECD\u5728\u7B49\u5F85\u5973\u7AE5\u56DE\u5BB6\uFF0C\u5E0C\u671B\u5979\u80FD\u591F\u65E9\u65E5\u5E73\u5B89\u5F52\u6765\u3002"
  fadeInDuration: 2
  holdDuration: 3
  fadeOutDuration: 2
  scrollSpeed: 40
  bottomPadding: 80
  sceneToLoad: MainMenu
